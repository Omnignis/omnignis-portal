# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server-only, never NEXT_PUBLIC

# ---- Token encryption (32 random bytes, base64) ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---- Facebook app ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ---- This deployment's public URL ----
# MUST include the scheme and MUST NOT have a trailing slash.
# Correct:   https://portal.omnignis.com
# Wrong:     portal.omnignis.com          (no scheme -> Facebook rejects the redirect)
# Wrong:     https://portal.omnignis.com/ (trailing slash -> double slash in paths)
PORTAL_URL=https://portal.omnignis.com
